generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String       @unique
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  wards     Ward[]
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ward {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  wardNumber String
  name      String?
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, wardNumber])
}

model User {
  id                String             @id @default(uuid())
  employeeId        String?            @unique
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String
  role              Role
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  profilePhotoUrl   String?
  status            UserStatus         @default(OFFLINE)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastLoginAt       DateTime?
  
  // Relationships
  managerRelations  UserRelationship[] @relation("ManagerUser")
  subordinateRelations UserRelationship[] @relation("SubordinateUser")
  
  // Merged Issues/Tasks
  reportedIssues    Issue[]            @relation("IssueReporter")
  assignedIssues    Issue[]            @relation("IssueAssignee")
  issueHistories    IssueStatusHistory[] @relation("IssueHistoryChanger")
  issueAttachments  IssueAttachment[]  @relation("IssueAttachmentUploader")
  
  locationHistory   LocationHistory[]
  notifications     Notification[]
  initiatedCalls    Call[]             @relation("CallInitiator")
  receivedCalls     Call[]             @relation("CallRecipient")
}

model UserRelationship {
  id                String   @id @default(uuid())
  managerUserId     String
  manager           User     @relation("ManagerUser", fields: [managerUserId], references: [id])
  subordinateUserId String
  subordinate       User     @relation("SubordinateUser", fields: [subordinateUserId], references: [id])
  relationshipType  String
  createdAt         DateTime @default(now())

  @@unique([managerUserId, subordinateUserId])
}

enum Role {
  CITIZEN
  STAFF
  SUPERVISOR
  ADMIN
}

enum UserStatus {
  ONLINE
  AVAILABLE
  BUSY
  ON_TASK
  ON_BREAK
  OFFLINE
  EMERGENCY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  REPORTED
  RECEIVED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  VERIFIED
  CLOSED
  REJECTED
}

model Issue {
  id           String    @id @default(uuid())
  issueNumber  String    @unique @default(cuid())
  reportedById String
  reportedBy   User      @relation("IssueReporter", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("IssueAssignee", fields: [assignedToId], references: [id])
  
  cityId       String?
  city         City?     @relation(fields: [cityId], references: [id])
  wardId       String?
  ward         Ward?     @relation(fields: [wardId], references: [id])
  
  title        String
  description  String?
  priority     Priority  @default(MEDIUM)
  status       IssueStatus @default(REPORTED)
  category     String?
  
  locationLat  Float?
  locationLng  Float?
  address      String?
  
  deadline     DateTime?
  startedAt    DateTime?
  
  reportedAt   DateTime  @default(now())
  acceptedAt   DateTime?
  resolvedAt   DateTime?
  verifiedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  history      IssueStatusHistory[]
  attachments  IssueAttachment[]
}

model IssueStatusHistory {
  id          String      @id @default(uuid())
  issueId     String
  issue       Issue       @relation(fields: [issueId], references: [id])
  changedById String
  changedBy   User        @relation("IssueHistoryChanger", fields: [changedById], references: [id])
  oldStatus   IssueStatus?
  newStatus   IssueStatus
  remarks     String?
  locationLat Float?
  locationLng Float?
  createdAt   DateTime    @default(now())
}

model IssueAttachment {
  id           String    @id @default(uuid())
  issueId      String
  issue        Issue     @relation(fields: [issueId], references: [id])
  uploadedById String
  uploadedBy   User      @relation("IssueAttachmentUploader", fields: [uploadedById], references: [id])
  fileUrl      String
  fileType     String?
  mimeType     String?
  fileSize     BigInt?
  createdAt    DateTime  @default(now())
}

model LocationHistory {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  latitude    Float
  longitude   Float
  accuracy    Float?
  recordedAt  DateTime  @default(now())
}

model Notification {
  id              String    @id @default(uuid())
  recipientId     String
  recipient       User      @relation(fields: [recipientId], references: [id])
  type            String
  title           String
  message         String
  referenceType   String?   
  referenceId     String?
  isRead          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  readAt          DateTime?
}

model Call {
  id              String    @id @default(uuid())
  initiatedById   String
  initiatedBy     User      @relation("CallInitiator", fields: [initiatedById], references: [id])
  recipientId     String
  recipient       User      @relation("CallRecipient", fields: [recipientId], references: [id])
  callType        String    
  status          CallStatus @default(RINGING)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
}

enum CallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}
